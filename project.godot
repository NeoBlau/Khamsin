; Khamsin — Desert Courier
; Godot 4.5.1. Правки этого файла из редактора допустимы, но секции ниже
; расставлены руками и отсортированы по смыслу — сохраняйте порядок.

config_version=5

[application]

config/name="Khamsin"
config/description="Курьерский симулятор в аравийской пустыне: большая карта, честная физика, сюжет."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.039, 0.055, 1)
boot_splash/show_image=false

[autoload]

Config="*res://src/core/config.gd"
Rng="*res://src/core/rng.gd"
EventBus="*res://src/core/event_bus.gd"
Settings="*res://src/core/settings.gd"
SaveSystem="*res://src/core/save_system.gd"
GameState="*res://src/core/game_state.gd"
Telemetry="*res://src/core/telemetry.gd"
SceneRouter="*res://src/core/scene_router.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/integer_division=1
gdscript/warnings/shadowed_variable=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
3d/sleep_threshold_linear=0.05
3d/time_before_sleep=1.0

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.62, 0.55, 0.44, 1)

[threading]

worker_pool/max_threads=-1

